# To fix ModuleNotFoundError: No module named 'psycopg2'
# The MLFlow Docker image does not bundle specific database drivers.
# SQLAlchemy - the underlying ORM for postresql:// - is calling psycopg2
FROM ghcr.io/mlflow/mlflow:v2.11.3
# Install the pre-compiled Postgres driver
RUN pip install psycopg2-binary
